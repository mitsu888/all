#!/usr/bin/env bash
# subtitle — ワンタッチで英語動画に日本語字幕をつけるラッパースクリプト
#
# 使い方 / Usage:
#   ./subtitle path/to/video.mp4
#   ./subtitle path/to/video.mp4 -- --model medium --mode soft
#
# このスクリプトは初回実行時に:
#   1. Python 仮想環境 (.venv) を作成
#   2. requirements.txt から依存パッケージをインストール
#   3. ffmpeg があるか確認
# を自動で行い、video_ja_subtitle.py を実行します。
#
# 2 回目以降は既存の .venv を再利用するので高速です。

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="${SCRIPT_DIR}/.venv"
PY_SCRIPT="${SCRIPT_DIR}/video_ja_subtitle.py"

log() { printf '\033[1;36m[subtitle]\033[0m %s\n' "$*" >&2; }
err() { printf '\033[1;31m[subtitle]\033[0m %s\n' "$*" >&2; }

if [[ $# -lt 1 ]]; then
    err "使い方: $0 <入力動画> [-- 追加オプション]"
    err "例:     $0 movie.mp4"
    err "例:     $0 movie.mp4 -- --model medium --mode soft"
    exit 64
fi

# ffmpeg check
if ! command -v ffmpeg >/dev/null 2>&1; then
    err "ffmpeg が見つかりません。まず ffmpeg をインストールしてください。"
    err "  macOS:   brew install ffmpeg"
    err "  Ubuntu:  sudo apt-get install -y ffmpeg"
    exit 2
fi

# Python check
if ! command -v python3 >/dev/null 2>&1; then
    err "python3 が見つかりません。Python 3.9 以上をインストールしてください。"
    exit 2
fi

# Create venv on first run
if [[ ! -d "${VENV_DIR}" ]]; then
    log "初回実行: Python 仮想環境を作成します (${VENV_DIR})"
    python3 -m venv "${VENV_DIR}"
    # shellcheck disable=SC1091
    source "${VENV_DIR}/bin/activate"
    log "依存パッケージをインストールします..."
    pip install --upgrade pip >/dev/null
    pip install -r "${SCRIPT_DIR}/requirements.txt"
else
    # shellcheck disable=SC1091
    source "${VENV_DIR}/bin/activate"
fi

log "字幕生成を開始します: $1"
exec python "${PY_SCRIPT}" "$@"
